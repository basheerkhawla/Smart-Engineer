rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== دالة مساعدة: هل المستخدم أدمن؟ =====
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ===== دالة: هل المستخدم مسجل دخول؟ =====
    function isLoggedIn() {
      return request.auth != null;
    }

    // ===== دالة: هل هو نفس المستخدم؟ =====
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // ===== المستخدمون =====
    match /users/{userId} {
      // القراءة: المستخدم نفسه أو الأدمن
      allow read: if isOwner(userId) || isAdmin();

      // الإنشاء: المستخدم نفسه فقط (عند التسجيل)
      allow create: if isOwner(userId);

      // التعديل: المستخدم يعدل بياناته المسموحة فقط، أو الأدمن يعدل أي شيء
      allow update: if isAdmin() || (isOwner(userId) && 
        // المستخدم العادي لا يستطيع تعديل الحقول الحساسة
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'isBlocked', 'isAdFree', 'plan', 'maxReports']));

      // الحذف: الأدمن فقط
      allow delete: if isAdmin();
    }

    // ===== القوالب =====
    match /templates/{userId}/user_templates/{docId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ===== المشاريع =====
    match /projects/{userId}/user_projects/{docId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ===== التقارير =====
    match /reports/{userId}/user_reports/{docId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ===== الإشعارات العامة (للقراءة للجميع، الكتابة للأدمن) =====
    match /notifications/{docId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // ===== إعدادات التطبيق (قراءة للجميع، كتابة للأدمن) =====
    match /app_config/{docId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // ===== السجلات (الأدمن فقط) =====
    match /logs/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
